@font-face {
  font-family: 'Roboto';
  font-style: normal;
  font-weight: 400 900; /* Rentang berat variable font */
  font-display: swap;
  src: url('https://cdn.jsdelivr.net/gh/annoercm/pcthread/author/fonts/Roboto-Regular-VariableFont.woff2') format('woff2-variations'),
       url('https://fonts.gstatic.com/s/roboto/v48/KFO7CnqEu92Fr1ME7kSn66aGLdTylUAMa3yUBHMdazQ.woff2') format('woff2');
}
