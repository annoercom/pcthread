/* ---- ROBOTO 400 (REGULAR) ---- */
@font-face {
  font-family: 'Roboto';
  font-style: normal;
  font-weight: 400; /* Ini adalah ketebalan normal */
  font-display: swap; /* Penting untuk optimasi LCP */
  src: url('https://cdn.jsdelivr.net/gh/annoercom/pcthread/font/roboto-regular.woff2') format('woff2');
}
/* ---- ROBOTO 800 (EKSTRA-BOLD) ---- */
@font-face {
  font-family: 'Roboto';
  font-style: normal;
  font-weight: 800; /* Ini adalah ketebalan ekstra-tebal */
  font-display: swap; /* Penting untuk optimasi LCP */
  src: url('https://cdn.jsdelivr.net/gh/annoercom/pcthread/font/roboto-800.woff2') format('woff2');
}
